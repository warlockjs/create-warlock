{
  "name": "create-warlock",
  "version": "5.7.0",
  "description": "Project scaffolder for the Warlock.js framework — interactive wizard and non-interactive CLI for creating new apps.",
  "main": "./src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/create-warlock"
  },
  "type": "module",
  "bin": {
    "create-warlock": "./bin/create-app.js"
  },
  "scripts": {
    "start": "node node_modules/tsx/dist/cli.mjs ./index.dev.ts",
    "lint": "node node_modules/eslint/bin/eslint.js -c ./.eslintrc.json ./src",
    "fix": "node node_modules/eslint/bin/eslint.js --fix -c ./.eslintrc.json ./src --max-warnings=0",
    "format": "node node_modules/prettier/bin/prettier.cjs --write ./src/**/*.{js,jsx,ts,tsx,css,md,json} --config ./.prettierrc.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "format:template": "node scripts/format-check-template.mjs",
    "format:template:fix": "node scripts/format-check-template.mjs --write",
    "typecheck:scaffold": "node scripts/typecheck-scaffold.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "update": "node node_modules/tsx/dist/cli.mjs version-checker.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@mongez/copper": "^2.1.2",
    "@warlock.js/fs": "5.7.0",
    "@mongez/reinforcements": "^4.0.1",
    "cross-spawn": "^7.0.3",
    "rimraf": "^6.0.1",
    "which-pm-runs": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "4.1.10"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  }
}
